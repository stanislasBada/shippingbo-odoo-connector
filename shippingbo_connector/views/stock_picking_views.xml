<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_shippingbo" model="ir.ui.view">
        <field name="name">stock.picking.form.shippingbo</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_shippingbo" type="object"
                        string="Envoyer à Shippingbo"
                        invisible="shippingbo_order_id or picking_type_code != 'outgoing' or state in ('draft', 'done', 'cancel')"/>
                <button name="action_cancel_shippingbo" type="object"
                        string="Annuler sur Shippingbo"
                        confirm="Annuler la commande côté Shippingbo ?"
                        invisible="not shippingbo_order_id or shippingbo_state == 'cancelled' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shippingbo" name="shippingbo"
                      invisible="picking_type_code != 'outgoing'">
                    <group>
                        <group>
                            <field name="shippingbo_order_id" readonly="1"/>
                            <field name="shippingbo_state" readonly="1"/>
                            <field name="shippingbo_shipment_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="shippingbo_earliest_ship_date"/>
                            <field name="carrier_tracking_ref"/>
                            <field name="carrier_tracking_url" widget="url"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
